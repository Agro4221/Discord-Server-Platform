# Public VPS Dashboard reverse proxy.
# The application itself stays loopback-only on the host.
# Caddy terminates HTTPS and protects the Dashboard at the public edge.
# DASHBOARD_BASIC_AUTH_HASH must be a Caddy-supported password hash.

{$DOMAIN} {
  encode gzip

  basic_auth {
    {$DASHBOARD_BASIC_AUTH_USER} {$DASHBOARD_BASIC_AUTH_HASH}
  }

  header {
    X-Content-Type-Options nosniff
    X-Frame-Options DENY
    Referrer-Policy strict-origin-when-cross-origin
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
  }

  reverse_proxy dashboard:3000
}
