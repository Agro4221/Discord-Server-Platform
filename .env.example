# Discord
DISCORD_CLIENT_ID=
DISCORD_TOKEN=
DISCORD_TEST_GUILD_ID=
BOT_IDENTITY_ID=primary

# Bot health endpoint
HEALTH_HOST=127.0.0.1
HEALTH_PORT=3001

# Local management API (never expose directly to the public internet)
MANAGEMENT_API_HOST=127.0.0.1
MANAGEMENT_API_PORT=3002
MANAGEMENT_API_KEY=

# Dashboard
BOT_HEALTH_URL=http://127.0.0.1:3001/health
MANAGEMENT_API_URL=http://127.0.0.1:3002
MANAGEMENT_API_KEY=
DASHBOARD_SESSION_SECRET=
DASHBOARD_ADMIN_PASSWORD=

# Database
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/discord_platform

# Music / Lavalink
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
LAVALINK_PASSWORD=change-me-local
LAVALINK_SECURE=false
LAVALINK_NODES=

# Optional providers
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Backups
BACKUP_DIRECTORY=./data/backups
BACKUP_RETENTION_COUNT=30
# Optional S3-compatible remote backup storage
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=us-east-1
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=discord-server-platform
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_FORCE_PATH_STYLE=true
