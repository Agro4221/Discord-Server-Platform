# Local development configuration. Put real values only in .env.

DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_TEST_GUILD_ID=


DSP_CONTAINERIZED=false

MANAGEMENT_API_HOST=127.0.0.1
MANAGEMENT_API_PORT=39001
MANAGEMENT_API_KEY=
BOT_CREDENTIALS_ENCRYPTION_KEY=

DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=3000

DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/discord_platform
POSTGRES_PASSWORD=

# Music uses local yt-dlp + FFmpeg.
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
YTDLP_JS_RUNTIME=node
# Optional browser/exported cookies for restricted YouTube content.
YTDLP_COOKIES_FILE=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
YOUTUBE_API_KEY=

BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_ENCRYPTION_KEY=
