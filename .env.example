# Local development configuration. Put real values only in .env.

DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_TEST_GUILD_ID=

# Secondary bot identities
# DISCORD_TOKEN_MUSIC2=
# DISCORD_CLIENT_ID_MUSIC2=

DSP_CONTAINERIZED=false

MANAGEMENT_API_HOST=127.0.0.1
MANAGEMENT_API_PORT=39001
MANAGEMENT_API_KEY=

DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=3000
DASHBOARD_SESSION_SECRET=
DASHBOARD_ADMIN_PASSWORD=
DASHBOARD_AUTH_REQUIRED=true

DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/discord_platform
POSTGRES_PASSWORD=

LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
LAVALINK_PASSWORD=

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional LavaSrc music providers. Keep them disabled until their credentials
# are configured. Spotify may mirror playback to YouTube; Deezer/Yandex/VK can
# provide direct playback when their source is enabled.
LAVASRC_SPOTIFY_ENABLED=false
LAVASRC_APPLEMUSIC_ENABLED=false
LAVASRC_DEEZER_ENABLED=false
LAVASRC_YANDEXMUSIC_ENABLED=false
LAVASRC_VKMUSIC_ENABLED=false
LAVASRC_TIDAL_ENABLED=false
LAVASRC_QOBUZ_ENABLED=false
LAVASRC_YTDLP_ENABLED=false
LAVASRC_JIOSAAVN_ENABLED=false
LAVASRC_COUNTRY_CODE=DE

APPLE_MUSIC_API_TOKEN=
DEEZER_MASTER_DECRYPTION_KEY=
DEEZER_ARL=
YANDEX_MUSIC_ACCESS_TOKEN=
VK_MUSIC_USER_TOKEN=
TIDAL_TOKEN=
QOBUZ_USER_OAUTH_TOKEN=
YTDLP_PATH=yt-dlp
JIOSAAVN_SECRET_KEY=

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
YOUTUBE_API_KEY=
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_ENCRYPTION_KEY=
