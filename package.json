{
  "name": "discord-server-platform",
  "private": true,
  "version": "0.0.0-dev",
  "description": "Self-hosted Discord server platform",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "typecheck": "npm run typecheck -w apps/bot",
    "build:bot": "npm run build -w apps/bot",
    "test": "npm run test -w apps/bot",
    "dev:bot": "npm run dev -w apps/bot",
    "dev:dashboard": "npm run dev -w apps/dashboard"
  },
  "engines": {
    "node": ">=24.17.0"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
